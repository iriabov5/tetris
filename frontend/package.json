{
  "name": "tetris-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/api-client.mjs generate",
    "api:check": "node scripts/api-client.mjs check",
    "test:codegen": "node --test --experimental-test-coverage --test-coverage-include=scripts/api-client.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/codegen.lcov.info scripts/api-client.test.mjs",
    "predev": "npm run api:check",
    "prebuild": "npm run api:check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.10",
    "@playwright/test": "1.65.0",
    "orval": "8.49.0"
  }
}
